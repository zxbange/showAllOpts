#!/usr/bin/python3 -I
"""Forced command, run as ubuntu, never root; trust only reviewed installed files."""
import importlib.util
import json
import os
from pathlib import Path
import pwd
import re
import stat
import sys
import subprocess
import tempfile
from urllib.parse import urlsplit

ROOT = Path('/home/ubuntu/showAllOpts')
CONFIG = Path('/etc/showallopts-deploy.json')


def trusted_file(path):
    for item in (path, *path.parents):
        info = item.lstat()
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError('Installed automation paths must be root-owned and not group/other writable.')
    if not path.is_file():
        raise ValueError('Expected an installed regular file.')


def parse_command(command):
    match = re.fullmatch(r'(check|deploy) ([0-9a-f]{40})', command)
    if not match:
        raise ValueError('Only check/deploy followed by one lowercase full SHA is allowed.')
    return match.group(1), match.group(2)


def git(*args):
    result = subprocess.run(['/usr/bin/git', *args], cwd=ROOT, check=True, text=True,
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=120)
    return result.stdout.strip()


def reviewed_runner(sha):
    # Validate before importing any target code; never move the live checkout here.
    if git('remote', 'get-url', 'origin') not in (
            'https://github.com/zxbange/showAllOpts.git', 'https://github.com/zxbange/showAllOpts',
            'git@github.com:zxbange/showAllOpts.git'):
        raise ValueError('Unexpected repository origin.')
    if git('branch', '--show-current') != 'main' or git('status', '--porcelain'):
        raise ValueError('Expected a clean main checkout.')
    git('fetch', 'origin', 'main')
    if git('rev-parse', sha+'^{commit}') != sha:
        raise ValueError('Target did not resolve exactly.')
    git('merge-base', '--is-ancestor', sha, 'FETCH_HEAD')
    git('merge-base', '--is-ancestor', 'HEAD', sha)
    return git('show', sha+':scripts/deploy.py')


def load_config():
    trusted_file(CONFIG)
    data = json.loads(CONFIG.read_text())
    if set(data) != {'DEPLOY_WEB_URL', 'NODE_BIN'}:
        raise ValueError('Configuration must contain only DEPLOY_WEB_URL and NODE_BIN.')
    url = urlsplit(data['DEPLOY_WEB_URL'])
    if (url.scheme not in ('http', 'https') or not url.hostname or url.username or url.password
            or url.path not in ('', '/') or url.query or url.fragment):
        raise ValueError('DEPLOY_WEB_URL must be the actual site origin without credentials/path/query.')
    _ = url.port  # Validate malformed/out-of-range ports before any deployment work.
    node = Path(data['NODE_BIN'])
    if not node.is_absolute() or ':' in str(node) or not (node/'node').is_file() or not (node/'npm').is_file():
        raise ValueError('NODE_BIN must be the absolute installed Node.js bin directory.')
    return data


def main():
    operation, sha = parse_command(os.environ.get('SSH_ORIGINAL_COMMAND', ''))
    user = pwd.getpwuid(os.getuid())
    if os.geteuid() == 0 or user.pw_name != 'ubuntu':
        raise ValueError('Run as ubuntu, never root.')
    trusted_file(Path(__file__).absolute())
    config = load_config()
    # Do not source .bashrc/nvm scripts or trust SSH client environment variables.
    os.environ.clear()
    os.environ.update(HOME='/home/ubuntu', USER='ubuntu', LOGNAME='ubuntu', LANG='C.UTF-8',
                      PATH=config['NODE_BIN']+':/usr/local/bin:/usr/bin:/bin',
                      GIT_TERMINAL_PROMPT='0', GIT_SSH_COMMAND='ssh -oBatchMode=yes',
                      PIP_NO_INPUT='1', CI='true')
    os.umask(0o077)
    os.chdir(ROOT)
    source = reviewed_runner(sha)
    with tempfile.TemporaryDirectory(prefix='showallopts-runner-') as temporary:
        runner = Path(temporary)/'deploy.py'
        runner.write_text(source+'\n')
        spec = importlib.util.spec_from_file_location('tested_deployment_runner', runner)
        deploy = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(deploy)
        deploy.ROOT = ROOT
        args = ['--non-interactive', '--web-url', config['DEPLOY_WEB_URL'], '--commit', sha]
        if operation == 'check':
            # Fetch/read only: no live checkout switch, build, restart or release.
            deploy.NON_INTERACTIVE = True
            options = deploy.parse_args(args)
            deploy.preflight(options)
            deploy.ready(options.service, options.api_url)
            print('Authentication and deployment preflight passed for '+sha+'; no release attempted.')
            return 0
        return deploy.main(args)



if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        # Do not print configuration, environment or subprocess output.
        print('Deployment entry refused: '+type(exc).__name__, file=sys.stderr)
        raise SystemExit(1)
