# Local: backend/.env. Production: config/app.config in the project root.
# Set APP_ENV_FILE in the process environment, NOT inside this file.
APP_NAME=ShowAllOpts API
# Background polling for the social monitor; page access does not require login.
SOCIAL_WORKER_ENABLED=true
# Optional server-side QR login; leave empty to disable. Generate a private random key (24+ chars).
SOCIAL_BROWSER_LOGIN_KEY=
# Normally empty (bundled Chromium); use chrome only when installed deliberately.
SOCIAL_BROWSER_CHANNEL=
# true for CLI servers; false opens a window (Linux requires DISPLAY, e.g. Xvfb).
SOCIAL_BROWSER_HEADLESS=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_readonly_user
DB_PASSWORD=your_password
# JSON array; local frontend uses the Vite /api proxy by default.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Relative LOG_DIR resolves against the project root. Rotation uses server local midnight.
LOG_DIR=log
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Persistent local snapshots; daily refresh uses Asia/Shanghai, regardless of server timezone.
CACHE_ENABLED=true
CACHE_AUTO_REFRESH=true
CACHE_REFRESH_TIME=20:00
# Background cache reads only; direct database page queries retain their shorter timeout.
CACHE_DB_READ_TIMEOUT=600
# Total attempts per module for transient MySQL connection failures (1 disables retry).
CACHE_SYNC_ATTEMPTS=3

# Compress ownership JSON in MySQL query results; stored data remains unchanged.
CACHE_OWNERSHIP_COMPRESSION=true
